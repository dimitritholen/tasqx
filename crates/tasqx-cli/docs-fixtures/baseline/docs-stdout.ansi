        <span class="j-k">&quot;completions&quot;</span>: <span class="j-n">8</span>,
        <span class="j-k">&quot;project&quot;</span>: <span class="j-s">&quot;infra&quot;</span>,
        <span class="j-k">&quot;rework&quot;</span>: {
          <span class="j-k">&quot;count&quot;</span>: <span class="j-n">0</span>,
          <span class="j-k">&quot;n&quot;</span>: <span class="j-n">8</span>,
          <span class="j-k">&quot;rate&quot;</span>: <span class="j-n">0.0</span>,
          <span class="j-k">&quot;refs&quot;</span>: []
        }
      },
      {
        <span class="j-k">&quot;calibration&quot;</span>: {
          <span class="j-k">&quot;median_ratio&quot;</span>: <span class="j-n">1.3541666666666667</span>,
          <span class="j-k">&quot;n&quot;</span>: <span class="j-n">2</span>
        },
        <span class="j-k">&quot;closed&quot;</span>: <span class="j-n">15</span>,
        <span class="j-k">&quot;completions&quot;</span>: <span class="j-n">13</span>,
        <span class="j-k">&quot;project&quot;</span>: <span class="j-s">&quot;mobile&quot;</span>,
        <span class="j-k">&quot;rework&quot;</span>: {
          <span class="j-k">&quot;count&quot;</span>: <span class="j-n">2</span>,
          <span class="j-k">&quot;n&quot;</span>: <span class="j-n">13</span>,
          <span class="j-k">&quot;rate&quot;</span>: <span class="j-n">0.15384615384615383</span>,
          <span class="j-k">&quot;refs&quot;</span>: [
            <span class="j-n">17</span>,
            <span class="j-n">19</span>
          ]
        }
      },
      {
