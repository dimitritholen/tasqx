        <span class="j-k">&quot;modified&quot;</span>: <span class="j-s">&quot;2026-08-31T10:00:00Z&quot;</span>,
        <span class="j-k">&quot;project&quot;</span>: <span class="j-s">&quot;api&quot;</span>,
        <span class="j-k">&quot;short_id&quot;</span>: <span class="j-n">50</span>,
        <span class="j-k">&quot;status&quot;</span>: <span class="j-s">&quot;pending&quot;</span>,
        <span class="j-k">&quot;summary&quot;</span>: <span class="j-s">&quot;#50 · pending · H&quot;</span>,
        <span class="j-k">&quot;task&quot;</span>: <span class="j-b">null</span>,
        <span class="j-k">&quot;type&quot;</span>: <span class="j-s">&quot;task&quot;</span>
      },
      {
        <span class="j-k">&quot;id&quot;</span>: <span class="j-s">&quot;annotation:17dd6621-7db4-43b5-9f36-ddf89018081e&quot;</span>,
        <span class="j-k">&quot;label&quot;</span>: <span class="j-s">&quot;Ruling: the guide ships WITH the 3.0 release, not after it. A migration note th…&quot;</span>,
        <span class="j-k">&quot;modified&quot;</span>: <span class="j-s">&quot;2026-09-11T11:20:00Z&quot;</span>,
        <span class="j-k">&quot;project&quot;</span>: <span class="j-b">null</span>,
