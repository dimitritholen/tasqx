# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Agent worktrees created by Workflow isolation.
.claude/worktrees/
mutants.out/
mutants.out.old/

# hookify rules are per-machine guards, not part of the repo.
.claude/*.local.md

# Stray agent skills — kept on disk, not part of this project.
.agents/

# Session handoff notes: written for the next AI session, not for this repo.
# Goes stale within a day and names local paths. Kept on disk.
HANDOFF.md

# Execution plans: agent task-checklists for work already shipped.
docs/plans/

# The same, written at the root instead of under docs/. Work lives in tasqx.
/plans/

# Console logs and page snapshots a browser agent writes while verifying a page.
.playwright-mcp/

# Stage events the dev-cycle plugin logs while it routes a session. Same class
# as HANDOFF.md: agent bookkeeping, not part of the project.
.dev-cycle/

# Bytecode from importing the doc generators under docs/.
__pycache__/
*.pyc

# Local environment secrets — never committed.
.env

# nodeterm's local project metadata, not part of this repo.
.nodeterm/

# Finder metadata macOS drops into any directory it opens.
.DS_Store

# Tasqx Desktop (apps/tasqx-desktop): npm and Tauri build output. `gen/` holds
# the capability schemas tauri-build regenerates on every build.
node_modules/
apps/tasqx-desktop/dist/
apps/tasqx-desktop/src-tauri/target/
apps/tasqx-desktop/src-tauri/gen/
